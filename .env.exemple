# Copier en .env pour le développement local. Valeurs fictives, jamais de secret réel ici.
NODE_ENV=development
PORT=3000
# Adresse d'écoute (127.0.0.1 par défaut : accessible depuis cette machine uniquement)
HOST=127.0.0.1
# Rôle administrateur (migrations, scripts) — le serveur ne s'en sert qu'en développement, jamais en production
DATABASE_ADMIN_URL=postgres://kanbanx:kanbanx_dev@127.0.0.1:5432/kanbanx
# Rôle applicatif (soumis aux politiques RLS) — c'est lui que le serveur utilise
DATABASE_URL=postgres://kanbanx_app:kanbanx_app_dev@127.0.0.1:5432/kanbanx
# Mot de passe donné au rôle applicatif lors de la migration (développement seulement ; absent en production)
KANBANX_APP_PASSWORD=kanbanx_app_dev
# URL publique (liens magiques)
BASE_URL=http://localhost:3000
# Données de démonstration au premier démarrage (1 = oui)
SEED_DEMO=1
# Envoi des liens par SMTP (vide = lien affiché dans la console). TLS obligatoire : smtps:// ou smtp:// avec
# STARTTLS. « ?tls=non » n'est accepté qu'hors production, pour un faux serveur local de test.
SMTP_URL=
# En production uniquement, derrière un proxy inverse qui pose X-Real-IP : TRUST_PROXY=1
